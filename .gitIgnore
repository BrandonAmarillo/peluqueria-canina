# .gitignore

# Ignore node_modules
node_modules/
# Ignore target directory
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
build.log

# Ignore log files
*.log

# Ignore temporary files
*.tmp
*.temp

# Ignore macOS generated files
.DS_Store
.AppleDouble
.LSOverride

# Ignore Windows generated files
Thumbs.db
ehthumbs.db
Desktop.ini

# Ignore build artifacts
dist/

# Ignore environment files
.env

# Ignore coverage reports
coverage/

# Ignore compiled Java files
*.class
.jar/
.war/

# Ignore IntelliJ IDEA project files
.idea/
*.iws
*.iml
*.ipr
out/

# Ignore Eclipse project files
.metadata/
.classpath
.project
.settings/
*.launch
bin/

# Ignore Visual Studio Code project files
.vscode/